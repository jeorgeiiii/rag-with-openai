# PostgreSQL with pgvector (Neon) - REQUIRED
# Get free account at https://neon.tech
# Make sure to enable pgvector extension in your database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Groq API - REQUIRED (for chat, free tier)
# Get API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Gemini API - REQUIRED (for embeddings, free tier)
# Groq has no embedding models, so this handles embeddings only
# Get API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Upload Service URL - OPTIONAL
# If using external upload service (for large files), set this
# Otherwise defaults to /api/upload (Vercel serverless function)
NEXT_PUBLIC_UPLOAD_URL=https://your-upload-service.com/upload

# Session Secret - OPTIONAL (for CSRF protection)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-secret-here-min-32-characters-long

# Office Working Directory - OPTIONAL
# Folder the Excel Assistant (/office) is allowed to read/write .xlsx files in.
# Defaults to ~/Documents/ChatbotOffice. Requires Windows + Excel installed
# locally - does not work on the Vercel deployment.
OFFICE_WORKDIR=C:\Users\you\Documents\ChatbotOffice
