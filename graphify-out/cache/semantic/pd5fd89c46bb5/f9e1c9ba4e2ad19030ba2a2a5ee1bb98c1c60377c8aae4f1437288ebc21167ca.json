urce_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses PostgreSQL's pgvector extension with HNSW indexing to perform fast approximate nearest neighbor search (cosine distance) over embeddings, trading exactness for speed so queries stay in the 3-5 second range."}, {"id": "readme_semantic_chunking", "label": "Semantic Chunking", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Targets 500 tokens (~2000 chars) per chunk with a 50-token overlap between chunks to prevent context loss at boundaries, and breaks at natural sentence/paragraph boundaries rather than arbitrary cut points; also strips null bytes and special characters."}, {"id": "readme_optimized_for_speed", "label": "Optimized for Speed", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrieves only 3 chunks instead of 5 for 40% less context overhead, caps GPT-4o generation at 150 max tokens, and uses temperature 0.3 to keep answers fast, focused, and non-rambling; session isolation also avoids cross-user context bloat."}, {"id": "readme_security_features", "label": "Security Features", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_csrf_protection", "label": "CSRF Protection", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_session_isolation", "label": "Session Isolation", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "